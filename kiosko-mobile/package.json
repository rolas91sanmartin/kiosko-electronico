{
  "name": "kiosko-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/start.cjs",
    "start:lan": "node scripts/start.cjs --lan",
    "android:reverse": "node scripts/android-reverse.cjs",
    "android": "expo run:android",
    "android:aab": "node scripts/release-aab.cjs",
    "android:aab:retry": "node scripts/release-aab.cjs --no-bump",
    "android:version-code": "node scripts/release-aab.cjs --bump-only",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-camera": "~57.0.4",
    "expo-crypto": "~57.0.2",
    "expo-image-manipulator": "~57.0.15",
    "expo-local-authentication": "~57.0.2",
    "expo-print": "~57.0.1",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "^13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  }
}
