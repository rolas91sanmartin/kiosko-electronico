# Runtime de Coolify. Reemplazar todos los CAMBIAR_* antes de desplegar.
NODE_ENV=production
PORT=3000
SWAGGER_ENABLED=false
KIOSK_API_KEY=CAMBIAR_API_KEY
KIOSK_DB_SERVER=CAMBIAR_HOST_SQL
KIOSK_DB_NAME=RRHH
KIOSK_DB_USER=CAMBIAR_USUARIO_SQL
KIOSK_DB_PASSWORD=CAMBIAR_PASSWORD
KIOSK_DB_PORT=1433
KIOSK_DB_ENCRYPT=true
KIOSK_DB_TRUST_CERT=false

# Persistencia: montar un volumen en /app/data (usuario 1000:1000).
KIOSK_PHOTO_DIRECTORY=/app/data/photos
KIOSK_LOG_FILE=/app/data/logs/kiosko-api.jsonl
KIOSK_SIGNING_KEY_PATH=/app/data/keys/payroll-signing-private.pem
KIOSK_SIGNING_PUBLIC_KEY_PATH=/app/data/keys/payroll-signing-public.pem
KIOSK_PC_ID=1
KIOSK_TIMEZONE=America/Guatemala
KIOSK_AUTO_DELAY_MS=250
KIOSK_CONFIRMATION_MS=1500
KIOSK_FACE_THRESHOLD=0.52
KIOSK_FACE_REQUIRED_MATCHES=3

# Opcionales: necesarios para reportes y consulta de logs, respectivamente.
KIOSK_RRHH_USER=rrhh
KIOSK_RRHH_PASSWORD=CAMBIAR_PASSWORD
KIOSK_TI_ADMIN_USER=tiadmin
KIOSK_TI_ADMIN_PASSWORD=CAMBIAR_PASSWORD

# Opcional: envío de comprobantes. Vacío deshabilita el correo.
KIOSK_SMTP_HOST=
KIOSK_SMTP_PORT=587
KIOSK_SMTP_SECURE=false
KIOSK_SMTP_USER=
KIOSK_SMTP_PASSWORD=
KIOSK_SMTP_FROM=
